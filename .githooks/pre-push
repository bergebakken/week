#!/bin/sh
# Publishes the site whenever main is pushed, so the live page never lags the code.
# Enabled with: git config core.hooksPath .githooks
set -e
[ "$(git rev-parse --abbrev-ref HEAD)" = "main" ] || exit 0

echo "pre-push: running tests"
npm test --silent

echo "pre-push: publishing to GitHub Pages"
sh scripts/deploy.sh
